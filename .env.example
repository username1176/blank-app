# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit credentials.

# Flyway — used by the Makefile / flyway.toml when FLYWAY_ENV=local
FLYWAY_URL=jdbc:postgresql://localhost:5432/warehouse_dev
FLYWAY_USER=postgres
FLYWAY_PASSWORD=postgres

# Staging (set in CI/CD secrets, not here)
# STAGING_DB_URL=jdbc:postgresql://...
# STAGING_DB_USER=...
# STAGING_DB_PASSWORD=...
