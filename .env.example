# Dentrix Integration
DENTRIX_API_KEY=your_dentrix_api_key
DENTRIX_BASE_URL=https://api.dentrix.com/v1

# Bland AI (Voice Agent)
BLAND_AI_KEY=your_bland_ai_key

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Availity (Insurance Verification)
AVAILITY_CLIENT_ID=your_availity_client_id
