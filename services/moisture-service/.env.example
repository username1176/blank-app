# Copy to .env — never commit .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=10.0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 16 chars.  Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_ALGORITHM=HS256
JWT_AUDIENCE=warehouse-platform
JWT_ISSUER=warehouse-platform

# ── Model ─────────────────────────────────────────────────────────────────────
# Absolute path to the moisture model weights (.pt / .pth).
# Leave empty to start the service without a model (health check still works).
MODEL_PATH=
TORCH_NUM_THREADS=0
MODEL_INPUT_SIZE=224
MODEL_CONFIDENCE_THRESHOLD=0.5

# ── Moisture detection ────────────────────────────────────────────────────────
MOISTURE_ALERT_THRESHOLD_PCT=15.0

# ── Training ──────────────────────────────────────────────────────────────────
# Root dir for versioned checkpoints: {MODEL_CHECKPOINT_DIR}/{customer_id}/{version}/
MODEL_CHECKPOINT_DIR=/checkpoints/moisture
# Upper bound on labelled samples per submission
MAX_TRAINING_SAMPLES=10000
# Max ZIP upload size (MB)
MAX_DATASET_ZIP_MB=500
