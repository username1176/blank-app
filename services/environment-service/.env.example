# Copy to .env — never commit .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 chars for HS256.  Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_AUDIENCE=warehouse-platform
JWT_ISSUER=warehouse-platform

# ── MQTT broker ───────────────────────────────────────────────────────────────
# Supported URL schemes: mqtt://, mqtts://, ws://, wss://
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=environment-service
MQTT_USERNAME=
MQTT_PASSWORD=
# QoS for subscriptions: 0 = at most once, 1 = at least once, 2 = exactly once
MQTT_QOS=1
# Reconnect interval when the broker is unreachable (ms)
MQTT_RECONNECT_MS=5000
# Set to "false" to disable MQTT in local/test environments
MQTT_ENABLED=true
# Root prefix for the topic hierarchy
# Full topic: {MQTT_TOPIC_PREFIX}/{customerId}/site/{siteId}/sensor/{sensorId}/readings
MQTT_TOPIC_PREFIX=warehouse

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=environment-service
KAFKA_ALERTS_TOPIC=alerts
# Set to "false" to disable Kafka publishing (no-op producer used instead)
KAFKA_ENABLED=true

# ── Anomaly detection ─────────────────────────────────────────────────────────
ANOMALY_ENABLED=true
# Hours of history used to compute the rolling mean/stddev baseline
ANOMALY_BASELINE_WINDOW_HOURS=24
# Readings required in the window before detection activates for a sensor
ANOMALY_MIN_READINGS=10
# Sigma thresholds: reading must deviate this many std-devs from baseline mean
ANOMALY_WARNING_SIGMA=2.0
ANOMALY_CRITICAL_SIGMA=3.0
# Minutes of silence after an alert fires before the same alert can re-fire
ANOMALY_COOLDOWN_MINUTES=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
