# Copy to .env — never commit .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 chars for HS256.  Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_AUDIENCE=warehouse-platform
JWT_ISSUER=warehouse-platform

# ── MQTT broker ───────────────────────────────────────────────────────────────
# Supported URL schemes: mqtt://, mqtts://, ws://, wss://
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=environment-service
MQTT_USERNAME=
MQTT_PASSWORD=
# QoS for subscriptions: 0 = at most once, 1 = at least once, 2 = exactly once
MQTT_QOS=1
# Reconnect interval when the broker is unreachable (ms)
MQTT_RECONNECT_MS=5000
# Set to "false" to disable MQTT in local/test environments
MQTT_ENABLED=true
# Root prefix for the topic hierarchy
# Full topic: {MQTT_TOPIC_PREFIX}/{customerId}/site/{siteId}/sensor/{sensorId}/readings
MQTT_TOPIC_PREFIX=warehouse

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
