# Copy to .env — never commit .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 chars for HS256.  Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_AUDIENCE=warehouse-platform
JWT_ISSUER=warehouse-platform

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=inventory-service
KAFKA_ALERTS_TOPIC=alerts
# Set to "false" to disable Kafka in local/test environments
KAFKA_ENABLED=true

# ── Alerting ──────────────────────────────────────────────────────────────────
# Drop-detection scheduler tick interval (ms)
ALERT_POLL_INTERVAL_MS=60000
# Fallback thresholds used when no customer/site config row exists
ALERT_DEFAULT_THRESHOLD_PCT=15
ALERT_DEFAULT_LOOKBACK_MINUTES=60
ALERT_DEFAULT_COOLDOWN_MINUTES=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: error | warn | info | http | debug
LOG_LEVEL=info
