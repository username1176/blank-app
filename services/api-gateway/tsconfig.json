{
  "compilerOptions": {
    "target":                          "ES2022",
    "module":                          "CommonJS",
    "moduleResolution":                "node",
    "lib":                             ["ES2022"],
    "outDir":                          "./dist",
    "rootDir":                         "./src",
    "strict":                          true,
    "noUncheckedIndexedAccess":        true,
    "noImplicitOverride":              true,
    "esModuleInterop":                 true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck":                    true,
    "sourceMap":                       true,
    "declaration":                     true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
