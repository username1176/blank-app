# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow any origin.
# In production, list only trusted frontend domains:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*
# Set to true when the frontend sends credentials (cookies / Authorization)
CORS_ALLOW_CREDENTIALS=false

# ── JWT authentication ─────────────────────────────────────────────────────────
# Signing secret for access tokens — must match the secret used by upstream services.
JWT_SECRET=supersecret-change-in-production
# Separate secret for refresh tokens — rotate independently of JWT_SECRET.
JWT_REFRESH_SECRET=refresh-supersecret-change-in-production
# When true, the gateway verifies the JWT and injects X-Customer-Id, X-User-Id,
# and X-Site-Ids headers into every proxied request.
JWT_VERIFY_AT_GATEWAY=true
# Access token lifetime (standard JWT duration: "15m", "1h", "24h").
JWT_ACCESS_TTL=15m
# Refresh token lifetime.  Increasing this raises the revocation window.
JWT_REFRESH_TTL=7d
# Comma-separated path prefixes that bypass JWT verification.
# /auth/login and /auth/refresh must always be present.
JWT_PUBLIC_PATHS=/health,/auth/login,/auth/refresh

# ── Upstream auth service ──────────────────────────────────────────────────────
# The gateway delegates credential validation here.
# Must expose: POST /authenticate → { userId, customerId, siteIds, email }
AUTH_SERVICE_URL=http://auth-service:3005

# ── Upstream services ─────────────────────────────────────────────────────────
INVENTORY_SERVICE_URL=http://inventory-service:3001
MOISTURE_SERVICE_URL=http://moisture-service:3002
ENVIRONMENT_SERVICE_URL=http://environment-service:3003
ALERT_SERVICE_URL=http://alert-service:3004

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Milliseconds before an upstream request times out
PROXY_TIMEOUT_MS=30000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# All limits are requests per window per IP address.
# REDIS_URL is optional — when set, limits are shared across gateway replicas.
REDIS_URL=

# Global ceiling (applied to every route before per-service limits)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=600

# Per-service limits (applied after the global ceiling)
RATE_LIMIT_INVENTORY_MAX=200
# Moisture service runs ML inference — keep this conservative
RATE_LIMIT_MOISTURE_MAX=60
RATE_LIMIT_ENVIRONMENT_MAX=300
RATE_LIMIT_ALERTS_MAX=200
# Auth endpoints — tighter window to limit brute-force attempts.
# Default: 20 attempts per 15 minutes per IP.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
