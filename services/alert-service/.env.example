# Copy to .env — never commit .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3004
NODE_ENV=development

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 chars for HS256.  Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying
JWT_AUDIENCE=warehouse-platform
JWT_ISSUER=warehouse-platform

# ── Kafka consumer ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=alert-service
# Consumer group — all replicas of this service share the same group so each
# partition is consumed by exactly one instance.
KAFKA_GROUP_ID=alert-service-group
# Topic published to by environment-service, inventory-service, etc.
KAFKA_ALERTS_TOPIC=alerts
# Set to "false" to disable Kafka (no-op consumer, useful in local/test envs)
KAFKA_ENABLED=true
# "true" → start from earliest offset (useful on first run / dev)
# "false" → start from latest (production default)
KAFKA_FROM_BEGINNING=false
# Max ms between heartbeats before the broker considers the consumer dead
KAFKA_SESSION_TIMEOUT_MS=30000
# ms between heartbeat sends (must be < session timeout / 3)
KAFKA_HEARTBEAT_INTERVAL_MS=3000
# Max ms to wait for a full batch of messages before delivering what's available
KAFKA_MAX_WAIT_MS=500

# ── Notifications ─────────────────────────────────────────────────────────────
# Set to "false" to silence all outbound notifications (no-op channels).
NOTIFICATIONS_ENABLED=true

# SendGrid (email)
# Obtain at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@warehouse-platform.io
SENDGRID_FROM_NAME=Warehouse Platform Alerts

# Twilio (SMS)
# Obtain at: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# E.164 format (+15551234567) or a Twilio Messaging Service SID (MGxxx…)
TWILIO_FROM_NUMBER=+15550000000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
