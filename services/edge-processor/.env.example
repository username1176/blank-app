# ── Device / site identity ────────────────────────────────────────────────────
SITE_ID=00000000-0000-0000-0000-000000000001
PILE_ID=00000000-0000-0000-0000-000000000002
CAMERA_ID_THERMAL=00000000-0000-0000-0000-000000000003
CAMERA_ID_RGB=00000000-0000-0000-0000-000000000004

# ── Camera sources ────────────────────────────────────────────────────────────
# RTSP URL for RGB camera (e.g. Axis, Hikvision, Reolink)
RGB_RTSP_URL=rtsp://user:pass@192.168.1.100:554/stream1

# Thermal camera source — either RTSP or V4L2 device node
# RTSP example (FLIR AX8, Axis Q series):
THERMAL_RTSP_URL=rtsp://user:pass@192.168.1.101:554/stream1
# V4L2 example (FLIR Lepton on USB/SPI adapter):
# THERMAL_V4L2_DEVICE=/dev/video1
# THERMAL_V4L2_WIDTH=160
# THERMAL_V4L2_HEIGHT=120
# THERMAL_V4L2_FORMAT=GRAY16_LE

# ── GStreamer hardware decode (Jetson only) ────────────────────────────────────
# Set to true to use nvv4l2decoder hardware pipeline (JetPack 5.x, L4T 35.x)
USE_GSTREAMER=false

# ── Capture settings ──────────────────────────────────────────────────────────
# Target capture FPS for each stream (independent of processing interval)
RGB_TARGET_FPS=5
THERMAL_TARGET_FPS=5
# How long to wait before reconnecting a dropped stream (seconds)
STREAM_RECONNECT_DELAY_S=3.0

# ── Processing interval ───────────────────────────────────────────────────────
# How often to run the full detection + upload pipeline (seconds)
PROCESS_INTERVAL_S=30

# ── Thermal calibration ───────────────────────────────────────────────────────
# raw_celsius = raw_pixel_value * THERMAL_SCALE + THERMAL_OFFSET
# Preset: centi-Kelvin (FLIR Lepton default) → scale=0.01, offset=-273.15
# Preset: FLIR raw K*40 → scale=0.04, offset=-273.15
# Preset: already Celsius → scale=1.0, offset=0.0
THERMAL_SCALE=0.01
THERMAL_OFFSET=-273.15
# Saturation limits — readings outside these are clamped / masked (°C)
THERMAL_MIN_VALID_C=-20.0
THERMAL_MAX_VALID_C=120.0
# Hot-spot threshold: pixel is a hot spot if temp > mean + N * std
THERMAL_HOT_SPOT_SIGMA=2.0

# ── Pile segmentation ─────────────────────────────────────────────────────────
# Method: adaptive_threshold | color_range | canny_edges
SEG_METHOD=adaptive_threshold
# Minimum contour area to be considered a pile (pixels)
SEG_MIN_AREA_PX=5000
# Minimum fraction of the image frame area the pile must occupy
SEG_MIN_FRAME_FRACTION=0.02
# Pixel → real-world calibration: how many sq. metres per pixel at the install height
# Compute from camera FOV and installation height. Example: 0.0005 m²/px at 8 m height
SEG_PIXEL_TO_M2=0.0005
# Heap shape factor for height estimation: h = k * sqrt(footprint_m2)
# Typical values: 0.25 (flat pile) … 0.50 (steep granular heap)
SEG_HEAP_HEIGHT_FACTOR=0.35
# colour-range mode: HSV lower/upper bounds (H,S,V)
# Default: sandy/brown range appropriate for grain / aggregate piles
SEG_COLOR_HSV_LOWER=10,30,60
SEG_COLOR_HSV_UPPER=40,255,255

# ── Ambient sensor defaults (optional — passed as sensor_readings to moisture-service) ──
# Leave blank to omit the sensor_readings field from predict requests
AMBIENT_TEMP_C=
AMBIENT_HUMIDITY_PCT=
AMBIENT_PRESSURE_HPA=

# ── API endpoints ─────────────────────────────────────────────────────────────
MOISTURE_API_URL=http://moisture-service:8000
INVENTORY_API_URL=http://inventory-service:3001

# JWT bearer token shared with backend services
API_JWT_TOKEN=your-jwt-token-here

# HTTP client settings
API_TIMEOUT_S=30
API_MAX_RETRIES=4
# Initial retry delay in seconds (doubles on each retry: 1s, 2s, 4s, 8s)
API_RETRY_INITIAL_DELAY_S=1.0

# ── Management REST API ───────────────────────────────────────────────────────
# Set to false to disable the management server entirely
MGMT_API_ENABLED=true
# Bind address — use 127.0.0.1 to restrict to loopback (localhost only)
MGMT_API_HOST=0.0.0.0
MGMT_API_PORT=8080
# Secret key required in the X-API-Key header on every request
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
MGMT_API_KEY=changeme-replace-with-a-strong-random-key
# Path where runtime config changes from PUT /update-config are persisted
CONFIG_OVERRIDES_PATH=/data/edge_config.json
# Set to true to enable Swagger UI at /docs (not recommended in production)
MGMT_API_DOCS=false

# ── Offline buffer ────────────────────────────────────────────────────────────
# Set to false to disable local buffering entirely (failed uploads are just logged)
BUFFER_ENABLED=true
# SQLite file path — back this with a persistent Docker volume so it survives restarts
BUFFER_DB_PATH=/data/edge_buffer.db
# Maximum number of pending rows; oldest are evicted when limit is reached
BUFFER_MAX_ROWS=10000
# Total BLOB storage cap (MB); oldest thermal JPEGs are evicted first
BUFFER_MAX_SIZE_MB=512.0
# Hours to keep successfully synced / permanently-failed rows before pruning
BUFFER_PRUNE_DONE_AFTER_H=24

# ── Sync policy ───────────────────────────────────────────────────────────────
# How many buffered entries to upload per sync pass (per processing cycle)
SYNC_BATCH_SIZE=50
# After this many failed attempts an entry is marked permanently failed
SYNC_MAX_ATTEMPTS=5
# Timeout for the lightweight /health/live connectivity probe (seconds)
SYNC_CONNECTIVITY_TIMEOUT_S=5.0

# ── Diagnostics ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Directory to save annotated debug frames (leave blank to disable)
DEBUG_FRAME_DIR=
# Max number of debug frames to keep (oldest deleted first)
DEBUG_FRAME_MAX=100
